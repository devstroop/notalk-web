{
  "name": "notalk-web",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "npm run build:css && (npm run watch:css & tsx watch --include templates --include public src/index.ts)",
    "dev:worker": "wrangler dev --port 3000",
    "dev:css": "tailwindcss -i ./src/styles/input.css -o ./public/static/css/app.css --watch",
    "watch:css": "tailwindcss -i ./src/styles/input.css -o ./public/static/css/app.css --watch",
    "build:css": "tailwindcss -i ./src/styles/input.css -o ./public/static/css/app.css --minify",
    "build": "npm run build:css && rm -rf dist && tsc && cp -R templates dist/templates && cp -R public dist/public",
    "build:worker": "npm run build:css && wrangler deploy --dry-run",
    "start": "node dist/index.js",
    "start:worker": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production",
    "cf-typegen": "wrangler types",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "hono": "^4.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "autoprefixer": "^10.5.5",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "wrangler": "^3.114.0"
  }
}
